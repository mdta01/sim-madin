# ============================================================================
# SIM MADIN — Environment Variables (TEMPLATE)
# ============================================================================
# Copy file ini ke .env dan isi nilai sesuai konfigurasi Supabase project Anda.
# Panduan lengkap: docs/MIGRATION-SUPABASE.md
# ============================================================================

# ── SUPABASE — Project Settings ============================================
# Didapat dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...(anon public key)

# Server-only — NEVER expose ke client! Bypass RLS, full admin access.
# Didapat dari: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...(service_role key)

# ── DATABASE — Supabase Postgres ===========================================
# Didapat dari: Supabase Dashboard → Project Settings → Database → Connection string
# Pakai POOLER URL (port 6543) untuk DATABASE_URL (menghindari max connections)
# Pakai DIRECT URL (port 5432) untuk DIRECT_URL (Prisma migrate butuh direct)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-southeast-1.supabase.com:5432/postgres

# ── NEXTAUTH (LEGACY — untuk backward compat selama transisi) ==============
# Hapus setelah semua client bermigrasi ke Supabase Auth
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── STORAGE — Optional, jika pakai Cloudflare R2 sebagai storage ===========
# Kalau tidak di-set, sistem akan fallback ke Supabase Storage (auto-detect)
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=sim-madin-uploads

# ── STORAGE STRICT MIME CHECK ==============================================
# Default 'true' — reject files dengan magic number tidak dikenal
# Set 'false' selama migrasi untuk kompatibilitas file lama
STORAGE_STRICT_MAGIC=true

# ── NODE ENV ===============================================================
NODE_ENV=development
