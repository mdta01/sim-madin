{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && next build",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "github": {
    "silent": true
  },
  "_envDocumentation": {
    "_comment": "Set env vars berikut di Vercel Dashboard → Project → Settings → Environment Variables. Lihat docs/MIGRATION-SUPABASE.md untuk panduan lengkap.",
    "_required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "DATABASE_URL (postgres pooler URL)",
      "DIRECT_URL (postgres direct URL)"
    ],
    "_optional": [
      "R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET (Cloudflare R2 storage)",
      "STORAGE_STRICT_MAGIC (default: true)"
    ]
  }
}
